    {
      "parameters": {
        "jsCode": "// Get the form data from the webhook\nconst name = $input.first().json.name;\nconst age_group = $input.first().json.age_group;\nconst screen_time = $input.first().json.screen_time_hours;\nconst participate = $input.first().json.participate;\nconst email = $input.first().json.email;\n\n// Calculate risk score from multiple factors\nlet risk_score = 0;\n\n// Factor 1: Screen time (most important factor)\nif (screen_time >= 8) {\n  risk_score += 3;\n} else if (screen_time >= 4) {\n  risk_score += 2;\n} else {\n  risk_score += 1;\n}\n\n// Factor 2: Age group\nif (age_group === \"18-22\") {\n  risk_score += 2;\n} else {\n  risk_score += 1;\n}\n\n// Factor 3: Participation intent\nif (participate === \"No\") {\n  risk_score += 2;\n} else if (participate === \"Maybe\") {\n  risk_score += 1;\n} else {\n  risk_score += 0;\n}\n\n// Determine category from total score\nlet category = \"\";\nlet category_reason = \"\";\n\nif (risk_score >= 5) {\n  category = \"High Risk\";\n  category_reason = \"High screen time with vulnerability factors\";\n} else if (risk_score >= 3) {\n  category = \"Moderate Usage\";\n  category_reason = \"Moderate screen time with awareness potential\";\n} else {\n  category = \"Low Usage\";\n  category_reason = \"Low screen time, good candidate for confirmation\";\n}\n\n// Return all data for next nodes\nreturn {\n  name: name,\n  age_group: age_group,\n  screen_time: screen_time,\n  participate: participate,\n  email: email,\n  risk_score: risk_score,\n  category: category,\n  category_reason: category_reason,\n  timestamp: new Date().toISOString()\n};"
      },
