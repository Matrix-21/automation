    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nlet errors = [];\n\n// Check each field\nif (!body.name) errors.push('Name is missing');\nif (!body.email) errors.push('Email is missing');\nif (!body.screen_time_hours && body.screen_time_hours !== 0) errors.push('Screen time is missing');\n\nif (body.screen_time_hours < 0 || body.screen_time_hours > 24) {\n  errors.push('Screen time must be between 0 and 24 hours');\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (body.email && !emailRegex.test(body.email)) {\n  errors.push('Email format is invalid');\n}\n\nif (body.participate && !['Yes', 'No', 'Maybe'].includes(body.participate)) {\n  errors.push('Participation must be Yes, No or Maybe');\n}\n\n// If errors found — flag but continue\nif (errors.length > 0) {\n  return {\n    name: body.name || 'Unknown',\n    email: body.email || '',\n    age_group: body.age_group || 'Not specified',\n    screen_time_hours: Number(body.screen_time_hours) || 0,\n    participate: body.participate || 'Unknown',\n    isValid: false,\n    validationErrors: errors.join(', ')\n  };\n}\n\n// All good\nreturn {\n  name: body.name,\n  email: body.email.toLowerCase().trim(),\n  age_group: body.age_group || 'Not specified',\n  screen_time_hours: Number(body.screen_time_hours),\n  participate: body.participate,\n  isValid: true,\n  validationErrors: ''\n};"
      },
      "type": "n8n-nodes-base.code",
